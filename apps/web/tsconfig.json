{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": false,
    "removeComments": false,
    "moduleDetection": "legacy",
    "outDir": "dist/js"
  },
  "files": [
    "src/types.ts",
    "src/hybrid-types.ts",
    "src/core.ts",
    "src/release-provenance.ts",
    "src/icons.ts",
    "src/charts.ts",
    "src/snapshot.ts",
    "src/hybrid-data.ts",
    "src/hybrid-core.ts",
    "src/champion-core.ts",
    "src/scene.ts",
    "src/hybrid-views.ts",
    "src/hybrid-controller.ts",
    "src/views.ts",
    "src/champion-views.ts",
    "src/champion-controller.ts",
    "src/roadmap-types.ts",
    "src/roadmap-data.ts",
    "src/advanced-visuals.ts",
    "src/study-visuals.ts",
    "src/roadmap.ts",
    "src/evidence.ts",
    "src/workflows.ts",
    "src/experiences.ts",
    "src/completion-ui.ts",
    "src/integrations-ui.ts",
    "src/app.ts"
  ]
}

+    const saved=raw.saved_setups.map((s:unknown):SavedSetup=>{
+      if(!isRecord(s)||typeof s.id!=='string'||!/^setup-[a-f0-9-]{36}$/i.test(s.id))throw new Error('Invalid setup identifier.');

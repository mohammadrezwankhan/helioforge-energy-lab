# Template only. scripts/dev.py does not automatically load this file.
HELIOFORGE_DB=data/helioforge.sqlite3
ENABLE_OPENAI=false
OPENAI_API_KEY=
OPENAI_MODEL=
ADMIN_API_KEY=

# Optional provider connectors. Keep secrets server-side; the browser asks for consent.
# Public Open-Meteo works without a key, subject to its service terms.
OPEN_METEO_API_KEY=
ENTSOE_API_TOKEN=
# Exact official HTTPS RSS/Atom URLs, configured by the operator; publication dates
# are not verified legal effective dates. Example shape: {"FR":"https://www.cre.fr/..."}
HELIOFORGE_REGULATORY_FEEDS={}
# Read-only Modbus TCP, functions 3/4 only, ADMIN_API_KEY required.
# Example shape: {"lab":{"host":"192.0.2.10","port":502,"unit":1,"address":0,"count":8,"function":4}}
HELIOFORGE_MODBUS_DEVICES={}

# Developer server only: explicit local host/origin allow-lists.
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# launch.py enforces loopback and disables external AI even if it is enabled above.
